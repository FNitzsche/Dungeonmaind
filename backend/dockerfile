FROM python:3.12.1

# Set working directory
WORKDIR /app

# Install system-level dependencies (including ffmpeg)
RUN apt-get update && apt-get install -y \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application source code
COPY app ./app

# Download and cache embedding model into /models
RUN mkdir -p /models && \
    python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('all-MiniLM-L6-v2', cache_folder='/models')"
ENV SENTENCE_TRANSFORMERS_HOME=/models

# TORCH_FORCE_NO_WEIGHTS_ONLY_LOAD=1 is a fix for the latest TORCH update
ENV TORCH_FORCE_NO_WEIGHTS_ONLY_LOAD=1
ENV WHISPERX_MODELS_DIR=/models/whisperx
ENV TORCH_HOME=/models/torch_cache

# Make directories for caching
RUN mkdir -p /models/whisperx /models/torch_cache/hub/checkpoints

# Pre-download WhisperX ASR model
RUN python -c "\
import whisperx; \
whisperx.load_model('base', language='en', device='cpu', compute_type='int8', download_root='/models/whisperx')"

# Pre-download WhisperX alignment model (wav2vec2) for english language
RUN python -c "\
import torch.hub; \
torch.hub.download_url_to_file( \
    'https://download.pytorch.org/torchaudio/models/wav2vec2_fairseq_base_ls960_asr_ls960.pth', \
    '/models/torch_cache/hub/checkpoints/wav2vec2_fairseq_base_ls960_asr_ls960.pth', \
    progress=True)"

# Alternatively pre-download wav2vec for german
#RUN python -c "\
#import torch.hub; \
#torch.hub.download_url_to_file( \
#    'https://download.pytorch.org/torchaudio/models/wav2vec2_voxpopuli_base_10k_asr_en.pt', \
#    '/models/torch_cache/hub/checkpoints/wav2vec2_voxpopuli_base_10k_asr_en.pt', \
#    progress=True)"

# If other languages are detected during runtime of the application, wav2vec might downlaod additional wav2vec models
# during runtime

# Expose the FastAPI port
EXPOSE 8000

# Run the app with Uvicorn
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]